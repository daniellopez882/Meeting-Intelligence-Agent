# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# This repository previously committed a .env containing a live DeepSeek API
# key. A later commit blanked the value, which does NOT remove it from git
# history. If a key has ever been committed here, rotate it.

# ---- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
BIND_HOST=127.0.0.1
PORT=8000

# Required on /api/process. That endpoint calls a model, so without a key
# anyone who can reach the port spends your API credit.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-in-production

# Comma-separated browser origins. Empty in production means none are allowed.
CORS_ALLOW_ORIGINS=http://localhost:8000

# ---- Model providers --------------------------------------------------------
# At least one is required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OPENAI_API_KEY is also satisfied by KIMI_API_KEY or DEEPSEEK_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
